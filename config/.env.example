# ============================================
# Kakadu - Sensitive Configuration Template
# Copy this to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# --- Oracle Database (Wallet mTLS) ---
ORACLE_WALLET_PATH=/path/to/your/wallet
ORACLE_WALLET_PASSWORD=your_wallet_password
ORACLE_TNS_ALIAS=your_tns_alias
ORACLE_USER=your_db_user
ORACLE_PASSWORD=your_db_password

# --- Pushover Alerts ---
PUSHOVER_USER_KEY=your_pushover_user_key
PUSHOVER_API_TOKEN=your_pushover_api_token

# --- API Keys (if required by data sources) ---
# AFR_API_KEY=your_afr_api_key
# YF_API_KEY=your_yahoo_api_key

# --- OCI Object Storage (backup) ---
OCI_CONFIG_PATH=/home/ubuntu/.oci/config
OCI_BUCKET_NAMESPACE=your_namespace
OCI_BUCKET_NAME=your_bucket_name

# --- Logging ---
LOG_LEVEL=INFO